ENV=DEV
PORT=3000

# Local Postgres (e.g. Postgres.app). Two databases, one per Prisma schema.
# `npm run init` creates and migrates both.
DATABASE_URL="postgresql://postgres:password123@localhost:5432/valio?schema=public"
EVENTSTORE_URL="postgresql://postgres:password123@localhost:5432/valio_events?schema=public"

SEED_USER_PASSWORD=hackjunction
PUBLIC_FRONTEND_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
# Extra trusted origins for sign-in (comma-separated), e.g. a second dev client
TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=kN7LmJZvHEuRVpyNiGRbulqLHXr0Az3Y
BETTER_AUTH_EMAILS=false
EMAIL_FROM_EMAIL=no-reply@example.com
EMAIL_FROM_NAME=Valio Gateway
SMTP2GO_API_ROOT=https://eu-api.smtp2go.com/v3
SMTP2GO_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Mandate gateway ---------------------------------------------------------
# Ed25519 signing key seed (any string; hashed to 32 bytes). Empty → derived
# from BETTER_AUTH_SECRET. Changing it invalidates existing signatures.
GATEWAY_SIGNING_SEED=
# Valio Aimo upstream. Leave URL or key empty to use the built-in simulator.
VALIO_API_URL=
VALIO_API_KEY=
# Customer number sent to Valio (doesn't change answers in the mock API).
VALIO_CUSTOMER=
# Optional: Valio's real product data (default: server/data/products.sample.json).
# The files live in the git-ignored ../data/ folder (Junction 2026 licence: use
# only for the challenge, never commit them). Paths are relative to server/
# (or absolute). Loaded once at startup (~1 s, 17.5k products).
# VALIO_PRODUCTS_FILE=../data/valio_aimo_junction26_product_data.json
# VALIO_RELIABILITY_FILE=../data/valio_aimo_junction26_delivery_reliability.csv
# VALIO_CARBON_FILE=../data/valio_aimo_junction26_carbon_footprint.csv
VALIO_PRODUCTS_FILE=
VALIO_RELIABILITY_FILE=
VALIO_CARBON_FILE=
# Optional: compile plain-language policies with Gemini (else rule-based parser).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Thinking level for Gemini 3 models (minimal | low | medium | high). Extraction only needs low (~1.7 s).
GEMINI_THINKING=low
# Enables POST /api/gw/demo/run and POST /api/gw/approvals/:id/expire.
DEMO_MODE=true
